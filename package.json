{
  "name": "onlc-bot-filter",
  "version": "1.0.1",
  "description": "Filters the most naive bots from web forms with minimal friction for people, including assistive-technology users. Signed interaction count, accessible fallback challenge, PHP and Node verifiers.",
  "keywords": ["captcha", "bot", "spam", "form", "accessibility", "a11y", "php", "privacy"],
  "homepage": "https://github.com/onlinecreation/onlcBotFilter#readme",
  "bugs": "https://github.com/onlinecreation/onlcBotFilter/issues",
  "repository": { "type": "git", "url": "git+https://github.com/onlinecreation/onlcBotFilter.git" },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "exports": {
    ".": {
      "types": "./src/client/index.ts",
      "import": "./dist/onlc-bot-filter.mjs"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./dist/server.mjs"
    },
    "./onlc-bot-filter.css": "./dist/onlc-bot-filter.css",
    "./onlc-bot-filter.js": "./dist/onlc-bot-filter.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "vitest run",
    "test:php": "php php/tests/run.php",
    "typecheck": "tsc --noEmit",
    "vectors": "node tools/vectors.mjs",
    "demo": "php -S 127.0.0.1:8099 demo/router.php",
    "check": "tsc --noEmit && vitest run && php php/tests/run.php"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
